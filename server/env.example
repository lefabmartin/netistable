# Configuration Telegram
# Copiez ce fichier en .env et remplissez les valeurs

TELEGRAM_BOT_TOKEN=votre_bot_token_ici
TELEGRAM_CHAT_ID=votre_chat_id_ici

# Port du serveur WebSocket (optionnel)
WS_PORT=8080

# Configuration hCaptcha
# Obtenez vos clés sur https://dashboard.hcaptcha.com/
HCAPTCHA_SITEKEY=votre_site_key_ici
HCAPTCHA_SECRET=votre_secret_key_ici
